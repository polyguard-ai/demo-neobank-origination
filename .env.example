# =============================================================================
# Polyguard sandbox app config (browser-exposed)
# =============================================================================
# Get these by creating a sandbox app at https://polyguard.ai
NEXT_PUBLIC_POLYGUARD_APP_ID=demo-beige-bank
NEXT_PUBLIC_POLYGUARD_API_SERVER=api.polyguard.ai

# Override the SDK CDN URL if you want to pin a specific version or self-host.
# Default: https://cdn.polyguard.ai/sdk/latest/sdk.js
# NEXT_PUBLIC_POLYGUARD_SDK_URL=https://cdn.polyguard.ai/sdk/v1.4.2/sdk.js

# =============================================================================
# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# =============================================================================
# 32-byte base64-encoded webhook secret from the Polyguard app dashboard.
# Used to AES-256-GCM-decrypt incoming webhook payloads.
POLYGUARD_WEBHOOK_SECRET=replace-with-32-byte-base64-key

# Comma-separated allow-list of hosts permitted for the presigned affidavit URL.
# SSRF / open-redirect defense for the "View Affidavit PDF" button.
POLYGUARD_AFFIDAVIT_HOST_ALLOWLIST=polyguard.ai,s3.amazonaws.com,s3.us-west-2.amazonaws.com

# =============================================================================
# Upstash Redis (REQUIRED on Vercel; optional for local dev)
# =============================================================================
# On Vercel, the /api/webhook handler and the /api/status + /admin/affidavit
# routes run in SEPARATE serverless functions — they cannot share an
# in-memory Map. We use Upstash Redis to bridge them. Free tier is plenty.
#
# Provision:
#   1. https://console.upstash.com -> Create Redis database (Global, free tier)
#   2. Copy the "REST API" URL and Token
#   3. Paste them here (and into Vercel env vars on the deployed project)
#
# If both vars are absent, the demo falls back to an in-process Map. That's
# fine for local `next dev` (single process), but on Vercel the affidavit
# view will silently fail to surface webhook data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
